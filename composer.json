{
    "name": "xola/omnipay-bundle",
    "type": "symfony-bundle",
    "description": "Integrates Omnipay 3 with Symfony 5.4",
    "keywords": [
        "omnipay",
        "payment",
        "credit card",
        "gateway",
        "symfony"
    ],
    "homepage": "https://github.com/xola/OmnipayBundle",
    "license": "MIT",
    "require": {
        "php": "^7.4|^8.0",
        "symfony/framework-bundle": "^5.4",
        "league/omnipay": "^3.2",
        "php-http/client-common": "^1.0|^2.0",
        "php-http/discovery": "^1.0",
        "php-http/httplug": "^1.0|^2.0",
        "php-http/logger-plugin": "^1.2",
        "php-http/message": "^1.0",
        "psr/http-client": "^1.0",
        "psr/http-message": "^1.0|^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5",
        "omnipay/authorizenet": "^3.3",
        "omnipay/eway": "^3.0",
        "omnipay/mollie": "^5.2",
        "omnipay/paymentexpress": "^3.0",
        "omnipay/paypal": "^3.0",
        "omnipay/sagepay": "^3.2",
        "omnipay/securepay": "^3.0",
        "omnipay/stripe": "^3.1",
        "omnipay/worldpay": "^3.0",
        "symfony/yaml": "^5.4"
    },
    "autoload": {
        "psr-4": {
            "Xola\\OmnipayBundle\\": ""
        }
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        }
    }
}
